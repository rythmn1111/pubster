# Pubster API — environment variables (see docs/BACKEND.md §Environment).
# Copy to `.env` and fill in real values. NEVER commit `.env` (CLAUDE.md §2).

NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://user:pass@localhost:5432/pubster
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
DUMMY_OTP_CODE=000000
CURRENCY=USD
CORS_ORIGINS=http://localhost:3000
