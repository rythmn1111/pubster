# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Prisma generated client (regenerated on install/deploy)
services/api/src/generated/

# Env — NEVER commit real env files (see CLAUDE.md §2)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Test / coverage
coverage/
.nyc_output/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---------- iOS / Xcode artifacts (apps/ios) ----------
# The Xcode project is generated by XcodeGen from apps/ios/project.yml — never
# commit it (keeps monorepo diffs clean). Regenerate with `xcodegen generate`.
*.xcodeproj/
apps/ios/*.xcodeproj
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
Pods/
Carthage/Build/
.swiftpm/
