{
  "name": "pubster",
  "version": "0.0.0",
  "private": true,
  "description": "Pubster monorepo — iOS app, web dashboards, and backend for discovering pubs, events, reservations and pre-orders.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "turbo run dev",
